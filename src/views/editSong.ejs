<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/admin_page.css">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,600,700&display=swap" rel="stylesheet">

</head>

<body>
    <header>
        <div class="container">
            <div class="nav_bar">
                <div class="logo">
                    <a class="logo_link" href="/admin">
                        <span>ADMIN</span>
                    </a>
                </div>
                <div class="middle_nav">
                    <div class="main_menu">
                        <ul class="menu_list">
                            <li class="home_menu"><a href="/display-alluser">User</a></li>
                            <li class="home_menu"><a href="/display-allalbum">Album</a></li>
                            <li class="home_menu"><a style="color: #fc0254;" href="/display-allsong">Song</a></li>
                            <li class="home_menu"><a href="/display-allartist">Artist</a></li>
                            <li class="home_menu"><a href="#">Favourite</a></li>
                        </ul>
                    </div>
                </div>
                <div class="right_nav">
                    <div class="help">
                        <a href="#">
                            <span style="color: #9b9b9be7;">Help</span>
                        </a>
                    </div>
                    <div class="divider">
                        <a style="cursor: context-menu;" href="#">|</a>
                    </div>
                    <div class="sign_up">
                        <a href="/home">
                            <span style="color: #fc0254;">Return to Homepage</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>


    <h1 class="create-song-title">Edit Song</h1>
    <form action="/put-song" method="POST" enctype="multipart/form-data" class="create-song-form">
        <input type="hidden" name="id" value="<%= song.id %>">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" value="<%= song.title %>" required><br><br>

        <label for="artist">Artist:</label>
        <select name="artist_id" id="artist_id">
            <% dataTable1.forEach(artist=> { %>
                <option value="<%= artist.id %>" <%=song.artist_id===artist.id ? 'selected' : '' %>><%= artist.name %>
                </option>
                <% }) %>
        </select><br><br>

        <label for="album">Album:</label>
        <select name="album_id" id="album_id">
            <% dataTable.forEach(album=> { %>
                <option value="<%= album.id %>" <%=song.album_id===album.id ? 'selected' : '' %>><%= album.title %>
                </option>
                <% }) %>
        </select><br><br>
        <label type="date" for="release_date">Release Date:</label>
        <input type="text" id="release_date" name="release_date" value="<%= song.release_date %>" required><br><br>

        <label for="img">FileImage:</label>
        <input type="text" id="img" name="imgUrl" value="<%= song.img %>"><br><br>

        <label for="imgFile">ImageURL:</label>
        <input type="file" name="imgFile" accept="image/*"><br><br>

        <label for="Upload">Upload</label>
        <input type="file" name="file_url"><br><br>
        <button type="submit">Update Song</button>
    </form>
</body>

</html>