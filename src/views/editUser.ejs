<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin_page.css">
</head>

<body>
    <header>
        <div class="container">
            <div class="nav_bar">
                <div class="logo">
                    <a class="logo_link" href="/admin">
                        <span>ADMIN</span>
                    </a>
                </div>
                <div class="middle_nav">
                    <div class="main_menu">
                        <ul class="menu_list">
                            <li class="home_menu"><a style="color: #fc0254;" href="/display-alluser">User</a></li>
                            <li class="home_menu"><a href="/display-allalbum">Album</a></li>
                            <li class="home_menu"><a href="/display-allsong">Song</a></li>
                            <li class="home_menu"><a href="/display-allartist">Artist</a></li>
                            <li class="home_menu"><a href="#">Favourite</a></li>
                        </ul>
                    </div>
                </div>
                <div class="right_nav">
                    <div class="help">
                        <a href="#">
                            <span style="color: #9b9b9be7;">Help</span>
                        </a>
                    </div>
                    <div class="divider">
                        <a style="cursor: context-menu;" href="#">|</a>
                    </div>
                    <div class="sign_up">
                        <a href="/home">
                            <span style="color: #fc0254;">Return to Homepage</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <h1 class="create-song-title">Edit User</h1>
    <form action="/put-user" method="POST" class="create-song-form">
        <input type="hidden" name="id" value="<%= user.id %>">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" value="<%= user.username %>" required><br><br>
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= user.email %>" required><br><br>
        <label for="password">Password:</label>
        <input type="text" id="password" name="password" value="<%= user.password %>" required><br><br>
        <label for="status">Status:</label>
        <select id="status" name="status" required>
            <option value="active" <%=user.status==='active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%=user.status==='inactive' ? 'selected' : '' %>>Inactive</option>
        </select><br><br>
        <button type="submit">Update User</button>
    </form>
</body>

</html>