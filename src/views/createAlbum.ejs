<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/admin_page.css">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,600,700&display=swap" rel="stylesheet">

</head>

<body>
    <header>
        <div class="container">
            <div class="nav_bar">
                <div class="logo">
                    <a class="logo_link" href="/admin">
                        <span>ADMIN</span>
                    </a>
                </div>
                <div class="middle_nav">
                    <div class="main_menu">
                        <ul class="menu_list">
                            <li class="home_menu"><a href="/display-alluser">User</a></li>
                            <li class="home_menu"><a style="color: #fc0254;" href="/display-allalbum">Album</a></li>
                            <li class="home_menu"><a href="/display-allsong">Song</a></li>
                            <li class="home_menu"><a href="/display-allartist">Artist</a></li>
                            <li class="home_menu"><a href="#">Favourite</a></li>
                        </ul>
                    </div>
                </div>
                <div class="right_nav">
                    <div class="help">
                        <a href="#">
                            <span style="color: #9b9b9be7;">Help</span>
                        </a>
                    </div>
                    <div class="divider">
                        <a style="cursor: context-menu;" href="#">|</a>
                    </div>
                    <div class="sign_up">
                        <a href="/home">
                            <span style="color: #fc0254;">Return to Homepage</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <h1 style="color: rgb(0, 0, 0);" class="create-album-title">Create New Albums</h1>

    <div class="create-album-form">
        <form action="/post-album" method="POST" enctype="multipart/form-data">
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" required>

            <label for="release_date">Release Date:</label>
            <input type="text" id="release_date" name="release_date" required>

            <label for="artist_id">Artist:</label>
            <select name="artist_id" id="artist_id">
                <% if (typeof dataTable1 !=='undefined' && dataTable1 && dataTable1.length) { %>
                    <% dataTable1.forEach(artist=> { %>
                        <option value="<%= artist.id %>">
                            <%= artist.name %>
                        </option>
                        <% }) %>
                            <% } else { %>
                                <option value="">No artists available</option>
                                <% } %>
            </select>

            <label for="img">Image:</label>
            <input type="file" id="img" name="imgAlbumsFile" accept="image/*">

            <button type="submit">Create Album</button>
        </form>
    </div>
</body>

</html>